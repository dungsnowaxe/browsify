{
  "name": "Browsify Browser Addon",
  "description": "The Official Browsify Browser Addon for macOS.",
  "version": "0.2.0",
  "manifest_version": 2,
  "homepage_url": "https://github.com/snowaxe/browsify",
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  "permissions": ["contextMenus", "<all_urls>"]
}
